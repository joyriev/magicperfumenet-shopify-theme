{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 60px;
    padding-bottom: 450px;
    {% if section.settings.mobile_background_image != blank %}
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0.80) 0%, rgba(255, 255, 255, 0.60) 39%, rgba(255, 255, 255, 0.30) 61%, rgba(255, 255, 255, 0.02) 100%)
      , url('{{ section.settings.mobile_background_image | image_url }}') center right / cover no-repeat
      , #edf7f5;
    {% endif %}
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 120px;
      padding-bottom: 120px;
      {% if section.settings.background_image != blank %}
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.80) 0%, rgba(255, 255, 255, 0.60) 39%, rgba(255, 255, 255, 0.30) 61%, rgba(255, 255, 255, 0.02) 100%)
        , url('{{ section.settings.background_image | image_url }}') center right / cover no-repeat
        , #edf7f5;
      {% endif %}
    }
  }
{%- endstyle -%}

<div id="{{ section.id }}" class="section-{{ section.id }}-padding bg-cover bg-center">
  <div class="page-width">
    <div class="max-w-[550px] text-center md:text-left">
      <h1 class="m-0 text-3xl !leading-tight md:text-5xl font-black text-black tracking-tight">
        {{ section.settings.title_line_1 }}{% if section.settings.title_line_2 != blank %}<br>{{ section.settings.title_line_2 }}{% endif %}
      </h1>
      <h2 class="mt-5 mb-0 text-xl !leading-snug md:text-2xl font-bold text-black tracking-tight">
        {{ section.settings.subtitle }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="mt-4 mb-8 text-base !leading-relaxed md:text-lg text-black">{{ section.settings.description }}</p>
      {% endif %}
      <div class="flex gap-4 items-center justify-center md:justify-start">
        <a href="{{ section.settings.button_link }}" class="py-4 px-6 no-underline leading-tight bg-black text-white tracking-tight rounded-full">{{ section.settings.button_text }}</a>
        {% if section.settings.second_button_text != blank %}
          <a href="{{ section.settings.second_button_link }}" class="py-4 px-6 no-underline leading-tight bg-black text-white tracking-tight rounded-full">{{ section.settings.second_button_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Homepage Hero",
    "class": "homepage-hero",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image"
      },
      {
        "type": "image_picker",
        "id": "mobile_background_image",
        "label": "Mobile Background Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Homepage Hero"
      }, {
        "type": "text",
        "id": "title_line_1",
        "label": "Title Line 1",
        "default": "Luxurious perfumes."
      }, {
        "type": "text",
        "id": "title_line_2",
        "label": "Title Line 2",
        "default": "At affordable prices."
      }, {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "The world's No. 1 designer-inspired fragrances."
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Made by the same experts behind some of the world's best-known perfumes."
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "GET NORDIC GLADE"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "second_button_text",
        "label": "Second Button Text",
        "default": "GET NORDIC GLADE"
      }, {
        "type": "url",
        "id": "second_button_link",
        "label": "Second Button Link"
      }, {
        "type": "header",
        "content": "Section Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Homepage Hero"
      }
    ]
  }
{% endschema %}