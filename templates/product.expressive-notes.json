    "massive_review_4FRDnB": {
      "type": "massive-review",
      "blocks": {
        "review_8K779N": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_24.png",
            "content": "<p>\"This is my first purchase and I'm delighted. I'll never buy my perfume anywhere else again. I had never found a perfume alternative that smells truly authentic and consistent.\"</p>",
            "author": "Killian P.",
            "author_image": "shopify://shop_images/3_bottle_review.png",
            "date": "1 day ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_by9hw8": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_21.png",
            "content": "<p>\"This is the best perfume I've smelled in a very long time, the notes make me crazy with happiness. I'll keep this one in my rotation forever.\"</p>",
            "author": "Jenniffer W.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_fPt9TR": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_26.png",
            "content": "<p>\"The three perfumes I received are very good. They last a long time and smell as they should. I was only dissatisfied with the time it took to receive them. But honestly, I placed a second order, so just expect a delay. Haha!<br/>\"</p>",
            "author": "Clara P.",
            "date": "2 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_iLXFpR": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_04.png",
            "content": "<p>\"I had tried in vain to find perfumes that smell expensive and last a long time. This is exactly what I was looking for.\"</p>",
            "author": "Tiana N.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_NTwXWz": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_20.png",
            "content": "<p>\"I didn't really know what to expect, but it really impressed me. It smells super fresh and honestly quite close to Aventus. It holds well and the price is much better.\"</p>",
            "author": "Michael T.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_LJcYip": {
