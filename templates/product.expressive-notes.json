        "review_xDKQgM": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_08.png",
            "content": "<p>\"It's the kind of perfume that makes you feel groomed. Not overwhelming, just right. 👌\"</p>",
