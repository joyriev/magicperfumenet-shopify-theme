        "review_JtMENw": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_09.png",
            "content": "<p>\"The product arrived well packaged. The perfume wasn't broken, hadn't leaked and was in good condition. The perfume is perfect and didn't smell bad. I love it, high quality.\"</p>",
