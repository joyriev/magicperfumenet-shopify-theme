        "review_Xq6RVa": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Magyx_UGC_05.png",
            "content": "<p>\"I've been wearing Creed Aventus for years, but this is the closest dupe I've found — and for a fraction of the price. The pineapple-vanilla combination is perfectly achieved.\"</p>",
