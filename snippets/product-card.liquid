<div class="flex flex-col bg-white p-4 shadow-sm rounded-lg relative h-full">
    {% if product.tags contains 'bestseller' or product.tags contains 'onsale' or product.metafields.custom.custom_label != blank %}
        <div class="absolute top-3 left-4 flex gap-4">
            {% if product.tags contains 'bestseller' %}
                <div class="bg-blue-50 text-blue-600 px-2 py-1 text-xs rounded-full flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-star"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>Bestseller</span>
                </div>
            {% elsif product.tags contains 'onsale' %}
                <div class="bg-red-50 text-red-600 px-2 py-1 text-xs rounded-full">⚡ On Sale</div>
            {% endif %}
            {% if product.metafields.custom.custom_label != blank %}
                <div class="text-white bg-[#226139] px-2 py-1 text-xs">{{ product.metafields.custom.custom_label }}</div>
            {% endif %}
        </div>
    {% endif %}
    <a href="{{ product.url }}" class="flex">
        {% if product.tags contains 'local_image' %}
          {% assign image_found = false %}
          {% for image in product.images %}
            {% assign curr_currency = localization.country.iso_code | prepend: "bundle_" | downcase %}
            {% assign img_alt = image.alt | downcase %}
            {% if img_alt contains "bundle_" and img_alt == curr_currency %}
              {% assign image_found = true %}
              <img
                src="{{ image.src | image_url: width: 300 }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="w-full h-auto">
            {% endif %}
          {% endfor %}
          {% if image_found == false %}
            {% for image in product.images %}
              {% assign img_alt = image.alt | downcase %}
              {% if img_alt contains "bundle_usd" %}
                <img
                  src="{{ image.src | image_url: width: 300 }}"
                  alt="{{ image.alt }}"
                  height="{{ image.height }}"
                  width="{{ image.width }}"
                  class="w-full h-auto">
              {% endif %}
            {% endfor %}
          {% endif %}
        {% else %}  
            <img
            class="w-full h-auto"
            src="{{ product.images.first |  image_url: width: 300 }}"
            alt="{{ product.title }}"
            height="{{ product.images.first.height }}"
            width="{{ product.images.first.width }}">
        {% endif %}
    </a>
    {% comment %} <div class="line-clamp-3 text-sm [&_br]:hidden mt-2">
        {{ product.metafields.custom.short_description | metafield_tag }}
    </div> {% endcomment %}
    <h3 class="mb-3 text-base">
        <a class="no-underline text-black font-semibold" href="{{product.url}}">
        {{ product.title }}
        </a>
    </h3>

      {% if product.metafields.custom.inspiration != blank %}
        <div class="flex items-center gap-2 mb-2">
        <img 
            style="filter: blur(2px);" 
            class="object-contain object-center bg-white"
            src="{{ product.metafields.custom.inspiration.value.image | image_url }}"
            alt="{{ product.metafields.custom.inspiration.value.image.alt | escape }}"
            width="35" 
            height="35"
        >
        <div>
            <p class="text-xs my-0">Inspired By:</p>
            <h4 class="text-sm font-semibold my-0 line-clamp-1 inspiration_heading">{{ product.metafields.custom.inspiration.value.name }}</h4>
        </div>
        </div>
    {% endif %}

    {% unless product.handle == 'gift-set' or product.handle == 'gift-set-for-gentlemen' %}
        <div class="mb-3">
            {%- render 'price'
            , product: product
            , use_variant: true
            , show_badges: false
            , price_class: 'price--large'
            -%}
        </div>
    {% endunless %}
    <div class="mt-auto">
        <a class="hover:bg-[#17803d] bg-[#146b32] text-white uppercase text-sm font-semibold tracking-[2px] py-3 px-4 rounded-lg no-underline w-full text-center block" href="{{ product.url }}">
        Shop now
        </a>
    </div>
</div>